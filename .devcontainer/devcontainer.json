{
  "name": "FitCart browser workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "FitCart preview", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "npm install --no-fund",
  "postStartCommand": "node scripts/start-preview.mjs",
  "customizations": { "codespaces": { "openFiles": ["START_HERE.md"] } }
}
